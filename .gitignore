# ==========================================
# AZ OFFICE AUTOMATION - LOCAL WP
# Git Ignore
# ==========================================

# Local WP environment
conf/
logs/

# Local WP generated files
app/sql/
app/conf/
app/logs/

# WordPress uploads / generated media
app/public/wp-content/uploads/

# WordPress cache
app/public/wp-content/cache/
app/public/wp-content/upgrade/
app/public/wp-content/backups/

# WordPress temporary files
app/public/wp-content/debug.log
app/public/wp-content/*.log

# Environment / secret files
.env
.env.*
*.env

# OAuth / API credentials
*credentials*.json
*client_secret*.json
*oauth*.json

# Node / development dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/

# Git
.git/

# Temporary files
*.tmp
*.temp
*.bak
*.swp

# Local WordPress configuration
app/.envrc
app/public/wp-config.php

# Local WP helper/debug file
app/public/local-xdebuginfo.php